{
  "name": "rss-to-email-vite",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist cache.json || true",
    "dev": "npm run clean && node server",
    "email": "npm run build:js && node email",
    "build": "prettier --check . && tsc",
    "build:js": "tsc --outDir dist --noEmit false",
    "format": "prettier --write .",
    "start": "npm run build:js && node scheduler.js",
    "docker:build": "docker build -t rss-to-email .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "manage": "npm run build:js && node manage.js"
  },
  "dependencies": {
    "@react-email/button": "0.0.15",
    "@react-email/column": "0.0.10",
    "@react-email/container": "0.0.12",
    "@react-email/head": "0.0.9",
    "@react-email/heading": "0.0.12",
    "@react-email/hr": "0.0.8",
    "@react-email/html": "0.0.8",
    "@react-email/img": "0.0.8",
    "@react-email/link": "0.0.8",
    "@react-email/preview": "0.0.9",
    "@react-email/render": "0.0.15",
    "@react-email/section": "0.0.12",
    "@react-email/text": "0.0.8",
    "dayjs": "1.11.11",
    "node-cron": "^3.0.3",
    "node-html-parser": "6.1.13",
    "nodemailer": "^6.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.23.1",
    "rss-parser": "3.13.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/sqlite3": "^3.1.0",
    "@vitejs/plugin-react": "4.3.0",
    "express": "4.19.2",
    "prettier": "3.2.5",
    "rimraf": "5.0.7",
    "typescript": "5.4.5",
    "vite": "5.2.12"
  }
}
